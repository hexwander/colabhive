# Ensure consistent LF line endings across OSes (critical for curl | sh installers & Dockerfiles)
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ps1       text eol=crlf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.webp      binary
*.woff      binary
*.woff2     binary
