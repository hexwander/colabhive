# ==============================================================================
# ColabHive — Git Ignore Rules
# ==============================================================================

# Go build outputs & test artifacts
/colabhive
/colabhive.exe
/colab
/colab.exe
/bin/
/dist/
/out/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
coverage.html
go.work
go.work.sum

# Databases, WAL/SHM journals & runtime data
*.db
*.db-*
*.db*
*.sqlite
*.sqlite3
*.sqlite*
/data/
/runs/

# ColabHive encrypted vaults & sensitive local credentials (NEVER COMMIT)
.master.key
*.master.key
.chvault
*.chvault
*keyring*.cfg
keyringrc.cfg
keyring_pass.cfg
application_default_credentials.json
oauth_config.local.json
token.json
tokens.json
sessions.json
sessions.json.lock

# Environment variables & local secrets
.env
.env.*
!.env.example
!.env.*.example

# Frontend (Vite + React + pnpm)
node_modules/
web/node_modules/
web/dist/
/web/dist-pages/
web/dist-pages/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python SDK, virtual environments & test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
sdk/python/dist/
sdk/python/build/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS & Editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
