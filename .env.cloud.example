# ==============================================================================
# ColabHive — Production Cloud Environment Template (`.env.cloud.example`)
# ==============================================================================
# Copy to `.env.cloud` (gitignored) and populate secrets before deploying:
#   cp .env.cloud.example .env.cloud
#   chmod 600 .env.cloud
#
# Generate strong 256-bit hex secrets on Linux/macOS/WSL:
#   openssl rand -hex 32
# Or in Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# ==============================================================================

# 1. Public Domain & Canonical HTTPS URL
#    Used by Caddy Automatic TLS and Contributor Invite Links (`/contribute/:code`)
COLABHIVE_DOMAIN=hive.lab.example.com
COLABHIVE_PUBLIC_URL=https://hive.lab.example.com

# 2. Mandatory Cloud Security Secrets (REQUIRED in `--mode cloud`)
#    • COLABHIVE_ADMIN_TOKEN : Locks the Web Observatory UI & admin `/api/v1/*` routes.
#                              (Remote AI Agents should NOT use the admin token; mint
#                              scoped `ch_sk_...` keys in `/router` instead!)
#    • COLABHIVE_MASTER_KEY  : Encrypts all Google OAuth refresh/access tokens in
#                              `/data/colabhive.db` with AES-256-GCM at rest.
COLABHIVE_ADMIN_TOKEN=replace_with_64_char_hex_from_openssl_rand_hex_32
COLABHIVE_MASTER_KEY=replace_with_different_64_char_hex_from_openssl_rand_hex_32

# 3. Deployment Mode & Reverse-Proxy Header Trust
COLABHIVE_MODE=cloud
COLABHIVE_TRUST_PROXY=true

# 4. Host Port Binding (Keep `127.0.0.1` when fronting with Caddy, Nginx, or Cloudflare Tunnel)
COLABHIVE_BIND_ADDR=127.0.0.1
COLABHIVE_BIND_PORT=7860
TZ=UTC

# 5. Pool Scheduler & Reliability Watchdog Defaults
#    Strategies: waste-zero | max-balance | sticky-session | round-robin
COLABHIVE_DEFAULT_STRATEGY=waste-zero
COLABHIVE_KEEPALIVE_INTERVAL_SEC=8
COLABHIVE_ANTI_ZOMBIE_WATCHDOG=true

# 6. Optional: Custom Google OAuth 2.0 Web Client (1-Click HTTPS Redirect Flow)
#    Leave empty to use Google's zero-domain PKCE copy-paste flow out-of-the-box!
COLABHIVE_OAUTH_CLIENT_ID=
COLABHIVE_OAUTH_CLIENT_SECRET=
